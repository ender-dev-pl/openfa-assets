  "captions": [
    {
      "text_record": 1448,
      "text": "The warp field generator removes the ship temporarily from the space-time continuum, rendering it impervious to damage.",
      "first_frame": 29,
      "last_frame": 139
    },
    {
      "text_record": 1449,
      "text": "The integral flux capacitor stores energy until there is sufficient to safely create the warp field; the four monitored energy ducts channel this power to the generator itself.",
      "first_frame": 170,
      "last_frame": 280
    },
    {
      "text_record": 1450,
      "text": "The energy flow monitoring circuitry ensures that the warp field will cut out before the power input to the generator falls to a dangerous level.",
      "first_frame": 311,
      "last_frame": 421
    }
  ]
